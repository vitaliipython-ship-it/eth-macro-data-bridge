{
  "$schema": "./schemas/architecture_tree_sync_rules.schema.json",
  "schema_version": "1.0.0",
  "status": "active",
  "owner_truth_boundary": {
    "carrier_role_ru": "Машиночитаемый носитель правил синхронизации архитектурных деревьев для будущего валидатора.",
    "carrier_is_owner_truth": false,
    "schema_is_owner_truth": false,
    "architecture_trees_are_owner_truth": false,
    "validator_defines_architecture_truth": false,
    "owner_truth_sources": [
      "runtime code",
      "AGENTS.md",
      "genome/registries/**",
      "approved STD/ADR/CONTRACT owner artifacts",
      "approved DEV_TZ / PRR / closure artifacts",
      "approved runtime/docs surfaces"
    ],
    "forbidden_authority_sources": [
      "docs/10-Architecture/general/architecture-trees/**",
      ".benchmarks/**",
      "CHANGELOG.md",
      "docs/DOCUMENTATION_INDEX.json",
      "external/** except boundary/disposition docs"
    ]
  },
  "active_index": {
    "path": "docs/10-Architecture/general/current_architecture_tree.md",
    "role": "active architecture tree index",
    "required": true
  },
  "redirect_index": {
    "path": "docs/10-Architecture/general/current_architecture_tree_index.md",
    "role": "redirect/deprecated compatibility surface",
    "required": true
  },
  "package_policy": {
    "source": ".aife/review_package_rules.json",
    "excluded_paths": [
      "BSP/**",
      "external/everything-claude-code/**"
    ],
    "required_present_paths": [
      "external/README.md",
      "external/POLICY.md"
    ],
    "historical_disposition_paths": [],
    "notes_ru": "Carrier must not weaken existing review package policy."
  },
  "coverage_levels": [
    {
      "id": "per-file",
      "description_ru": "Каждый активный файл в зоне должен иметь отдельную строку/комментарий или явное исключение."
    },
    {
      "id": "per-family",
      "description_ru": "Группа однотипных файлов покрывается семейным описанием без ручного комментария на каждый файл."
    },
    {
      "id": "per-directory",
      "description_ru": "Достаточно описания каталога и его роли; отдельные файлы проверяются только при изменении ответственности."
    },
    {
      "id": "disposition-only",
      "description_ru": "Зона получает только диспозицию/границу, не полноценное активное архитектурное дерево."
    },
    {
      "id": "not-required",
      "description_ru": "Покрытие архитектурным деревом не требуется; зона исключена или не входит в review package."
    }
  ],
  "severity": [
    "error",
    "warning",
    "info"
  ],
