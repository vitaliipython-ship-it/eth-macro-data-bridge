  "comment_policy": [
    {
      "comment_policy_id": "root-files",
      "required_level": "per-file",
      "applies_to": [
        "root files"
      ],
      "forbidden_patterns": [
        "файл проекта",
        "настройки",
        "документация",
        "вспомогательный файл",
        "Python-модуль",
        "модуль",
        "конфигурация",
        "исходный список",
        "зафиксированный список"
      ],
      "exceptions": [
        "ignored/local-only files not included in review package"
      ],
      "severity": "error"
    },
    {
      "comment_policy_id": "runtime-python",
      "required_level": "per-file",
      "applies_to": [
        "active runtime .py files"
      ],
      "forbidden_patterns": [
        "файл проекта",
        "настройки",
        "документация",
        "вспомогательный файл",
        "Python-модуль",
        "модуль",
        "конфигурация",
        "исходный список",
        "зафиксированный список"
      ],
      "exceptions": [
        "__init__.py can be per-family/per-directory when package role is already explicit"
      ],
      "severity": "error"
    },
    {
      "comment_policy_id": "resource-assets",
      "required_level": "per-family",
      "applies_to": [
        "resources/**",
        "icons/assets"
      ],
      "forbidden_patterns": [
        "файл проекта",
        "вспомогательный файл"
      ],
      "exceptions": [
        "binary/image assets are not manually commented one by one"
      ],
      "severity": "warning"
    },
    {
      "comment_policy_id": "project-control",
