{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/vitaliipython-ship-it/eth-macro-data-bridge/main/schema/market.schema.json",
  "title": "ETH Macro Market Bridge",
  "type": "object",
  "required": [
    "schema_version",
    "collector_version",
    "generated_at_utc",
    "generated_at_epoch_ms",
    "bridge_status",
    "policy",
    "providers"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "collector_version": {
      "type": "string"
    },
    "generated_at_utc": {
      "type": "string"
    },
    "generated_at_epoch_ms": {
      "type": "integer"
    },
    "bridge_status": {
      "enum": [
        "PASS",
        "DEGRADED"
      ]
    },
    "policy": {
      "type": "object"
    },
    "providers": {
      "type": "object",
      "required": [
        "binance",
        "kraken"
      ],
      "properties": {
        "binance": {
          "type": "object"
        },
        "kraken": {
          "type": "object"
        }
      }
    }
  },
  "additionalProperties": true
}
