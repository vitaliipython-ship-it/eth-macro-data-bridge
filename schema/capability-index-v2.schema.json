    "provider_policies":{"type":"array","items":{"type":"object","properties":{"provider_id":{"type":"string","minLength":1},"status":{"type":"string"},"runtime_scope":{"type":"string"},"target_state":{"type":"string"},"provider_policy_transition":{"type":"string"}},"additionalProperties":true}},
    "profiles":{"type":"object","additionalProperties":{"type":"object","required":["provider_id","source_provider","history_mode","availability_status","cold_manifest_path","warm_manifest_path","plan_schema","series_kind","coverage_semantics","finality_policy","revision_policy","hot_source_policy"],"properties":{"provider_id":{"type":"string"},"source_provider":{"type":"string"},"history_mode":{"enum":["MAX_AVAILABLE","PROVIDER_LIMITED","FORWARD_ONLY","FROZEN_REFERENCE","UNAVAILABLE"]},"availability_status":{"type":"string"},"cold_manifest_path":{"type":"string"},"warm_manifest_path":{"type":["string","null"]},"hot_manifest_path":{"type":["string","null"],"description":"Compatibility alias only; not the successor semantic name."},"plan_schema":{"enum":["market-data-resolution-plan/1.0.0","market-data-resolution-plan/2.0.0"]},"series_kind":{"enum":["OHLCV","SCALAR_TIME_SERIES","STRUCTURED_TIME_SERIES","SNAPSHOT_SERIES","OPTION_SURFACE","ORDER_BOOK_SNAPSHOT"]},"coverage_semantics":{"enum":["FIXED_GRID","SAMPLED_SCHEDULE","EVENT_DRIVEN"]},"finality_policy":{"enum":["FINALIZED_ONLY","OBSERVED_SNAPSHOT","PROVISIONAL_ALLOWED_EXPLICITLY"]},"revision_policy":{"enum":["IMMUTABLE","STRICT_OVERLAP_REQUIRED","WINDOW_ANCHORED_CUMULATIVE","PROVIDER_REVISABLE_SNAPSHOT"]},"hot_source_policy":{"type":"object","additionalProperties":false,"required":["status","locator_authority","transport_authority","runtime_class","provider_policy_transition_required"],"properties":{"status":{"enum":["ACTIVE_CANONICAL","NOT_ACTIVE","QUALIFIED_RUNTIME_REQUIRED"]},"locator_authority":{"enum":["CANONICAL_CONTROL_PLANE","NONE"]},"transport_authority":{"enum":["CANONICAL_CONTROL_PLANE","NONE"]},"runtime_class":{"enum":["DECLARED_RESOURCE","GITHUB_HOSTED","QUALIFIED_VPS","NONE"]},"provider_policy_transition_required":{"type":"boolean"},"runtime_task":{"type":["string","null"]}}}},"additionalProperties":true}},
