      "recovery_anchor": "MAX(CYCLES_STARTED_AT,CYCLES_COMPLETED_AT,LEASE_ACQUIRED_AT,LEASE_UNTIL,CYCLE_CHECKPOINTS_CREATED_AT,CAPABILITY_LEDGER_COLLECTED_AT)",
      "recovery_bound_seconds": 86400,
      "recovery_deadline_boundary": "NOW_MS<=RECOVERY_ANCHOR_MS+86400000_ALLOWED",
      "new_cycle_creation_after_stale_bound": false,
      "terminal_cycle_stale_recovery": false,
      "live_lease_precedes_stale_recovery": true,
      "attempt_progression": "PRIOR_ATTEMPT_PLUS_1",
      "max_attempts": 3,
      "no_unbounded_historical_resurrection": true
