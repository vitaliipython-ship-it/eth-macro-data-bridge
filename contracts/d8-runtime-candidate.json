  },
  "d9_seam": {
    "observation_envelope": "market-data-d8-runtime-observation/1.0.0",
    "is_history_schema": false,
    "purpose": "DURABLE_TRANSPORT_PROVENANCE_ENVELOPE",
    "forward_route": "qualified observation -> sqlite spool+ledger -> D9 FIXED_GRID/SAMPLED_SCHEDULE representation -> future WARM -> existing D9 sealing",
    "provider_reacquire": false,
    "same_observation_identity": true,
    "same_provenance_model": true,
    "known_at_compatibility": true,
    "finality_compatibility": true,
    "collection_gap_compatibility": true,
    "no_second_resolver": true,
    "no_second_data_authority": true,
    "runtime_to_warm_source_ready": true,
    "production_warm_forwarder_deployed": false
  },
  "high_cardinality": {
    "decision": "SUPPORTED_CANDIDATE",
    "backend": "VERSIONED_SQLITE_SPOOL",
    "retention": "PENDING_UNTIL_FORWARD_ACK; FORWARDED_7D_DEFAULT; 128M_HARD_CAP_WITH_EXPLICIT_SPOOL_FULL",
    "provenance": "OBSERVATION_ID+FINGERPRINT+KNOWN_AT+SOURCE_REVISION+RUNTIME_REVISION",
    "activation": false,
    "immutable_github_release_mutation_required": false
  },
  "shadow": {
