  "collect_cycle": {
    "interface": "POST /v1/collect-cycle",
    "request_schema": {
      "schema_version": "eth-macro-d8-collect-cycle-request/1.0.0",
      "allowed_fields": [
        "schema_version",
        "expected_schedule_at",
        "canonical_slot",
        "trace_id"
      ],
      "canonical_slot": "M5",
      "max_body_bytes": 65536,
      "future_clock_skew_seconds": 120,
      "stale_slot_seconds": 1200,
      "forbidden_semantics": [
        "provider",
        "capability",
        "url",
        "api_route",
        "symbol_implementation",
        "retry_count",
        "storage_path",
        "authority_mode"
      ]
    },
    "response_schema": {
      "schema_version": "eth-macro-d8-collect-cycle-response/1.0.0",
      "overall_status": [
        "PASS",
        "DEGRADED",
        "FAIL"
      ],
      "capability_status": [
        "PASS",
        "FAIL",
        "DEGRADED",
        "NOT_DUE",
        "DISABLED_BY_POLICY"
      ],
      "raw_market_payload_returned": false
    }
  },
  "failure_classes": [
    "PROVIDER_CONNECTIVITY",
    "PROVIDER_RATE_LIMIT",
    "PROVIDER_SCHEMA",
    "PROVIDER_TIMEOUT",
    "VALIDATION_FAILED",
    "STATE_IO",
    "STATE_SCHEMA_INCOMPATIBLE",
    "LEDGER_CONFLICT",
    "LOCK_BUSY",
    "STALE_LOCK_RECOVERED",
    "HOT_PROMOTION_FAILED",
    "SPOOL_FULL",
    "AUTH_FAILED",
    "REQUEST_INVALID",
    "RUNTIME_INTERNAL"
  ],
  "state": {
    "backend": "SQLITE_WAL_PERSISTENT_VOLUME",
    "state_schema_version": 1,
    "runtime_state_root_env": "RUNTIME_STATE_ROOT",
    "default_container_path": "/var/lib/eth-macro-data-bridge",
    "external_database_required": false,
    "startup_compatibility": "FAIL_CLOSED",
    "logical_areas": {
      "HOT": "sqlite.hot",
      "SPOOL": "sqlite.spool",
      "LEDGER": "sqlite.cycles+sqlite.capability_ledger",
      "LOCKS_LEASES": "sqlite.leases"
    },
    "sqlite": {
      "journal_mode": "WAL",
      "synchronous": "FULL",
      "transactional_terminalization": true
    },
    "spool": {
      "max_bytes": 134217728,
      "retention_seconds": 604800,
      "retention_policy": "PENDING_UNTIL_D9_FORWARD_ACK; FORWARDED_ELIGIBLE_FOR_PURGE_AFTER_7D; MAX_BYTES_HARD_CAP",
      "backpressure_policy": "FAIL_EXPLICIT_SPOOL_FULL_NO_SILENT_DROP",
      "idempotency_key": "observation_id"
    },
    "lease": {
      "default_seconds": 240,
      "owner_identity": true,
      "acquired_at": true,
      "lease_until": true,
      "terminal_release": true,
      "stale_detection": true,
      "stale_recovery": true
    },
    "hot": {
      "atomic_promotion": true,
      "promotion_condition": "OVERALL_PASS_ONLY",
      "failed_cycle_preserves_previous_hot": true,
      "partial_cycle_visible": false
    }
  },
  "idempotency": {
    "cycle_id": "sha256(runtime_contract_version|M5|expected_schedule_at)",
    "one_authoritative_cycle_per_slot": true,
    "pass_replay_without_provider_reacquire": true,
    "concurrent_same_slot": "LOCK_BUSY",
    "max_attempts_after_non_pass": 3,
    "observation_identity": "sha256(provider|series_id|provider_timestamp_at|payload_fingerprint)"
  },
  "freshness_and_gaps": {
    "synthetic_fill": false,
    "missing_observation": "COLLECTION_GAP",
    "distinguishes": [
      "NOT_DUE",
      "NO_OBSERVATION",
      "PROVIDER_FAILURE",
      "VALIDATION_FAILURE",
      "STALE_PREVIOUS_HOT"
    ],
    "freshness_retimestamping": false
  },
  "security": {
    "network_scope": "PRIVATE_DOCKER_NETWORK",
    "auth_mode": "BEARER_TOKEN_ENV_VPS_SHADOW",
    "secret_env": "D8_RUNTIME_TOKEN",
