    "hot": {
      "atomic_promotion": true,
      "promotion_condition": "OVERALL_PASS_ONLY",
      "failed_cycle_preserves_previous_hot": true,
      "partial_cycle_visible": false
    },
    "checkpoint": {
      "global_observation_storage": "sqlite.spool UNIQUE(observation_id)",
      "cycle_checkpoint_identity": "cycle_id+capability_id",
      "checkpoint_attempt_bound": true,
      "ordered_membership_storage": "sqlite.cycle_checkpoint_observations.position",
