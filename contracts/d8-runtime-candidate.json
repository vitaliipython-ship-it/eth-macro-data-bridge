        "PASS",
        "DEGRADED",
        "FAIL"
      ],
      "capability_status": [
        "PASS",
        "FAIL",
        "DEGRADED",
        "NOT_DUE",
        "DISABLED_BY_POLICY"
      ],
      "raw_market_payload_returned": false
